<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
    <title><%= blog.title %> | Blogify</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <style>
        .blog-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 60px 20px;
            margin-bottom: 40px;
            border-radius: 0;
        }

        .blog-header h1 {
            font-size: 3rem;
            font-weight: 700;
            margin: 0 0 20px 0;
            line-height: 1.2;
        }

        .blog-meta {
            display: flex;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            font-size: 0.95rem;
        }

        .blog-meta-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .reading-time {
            background: rgba(255,255,255,0.2);
            padding: 5px 12px;
            border-radius: 20px;
        }

        .blog-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Blog Content Styling */
        .blog-content {
            font-size: 1.1rem;
            line-height: 2;
            color: #2b2b2b;
            letter-spacing: 0.3px;
            word-spacing: 0.1em;
        }

        .blog-content h1, .blog-content h2, .blog-content h3 {
            margin-top: 4rem;
            margin-bottom: 2rem;
            font-weight: 700;
            color: #111;
            letter-spacing: 0.5px;
            line-height: 1.3;
        }

        .blog-content h1 { font-size: 2.5rem; margin-top: 5rem; }
        .blog-content h2 { font-size: 2rem; margin-top: 4.5rem; padding-top: 1.5rem; border-top: 2px solid #f0f0f0; }
        .blog-content h3 { font-size: 1.5rem; margin-top: 3rem; }
        .blog-content h4, .blog-content h5, .blog-content h6 { margin-top: 2.5rem; margin-bottom: 1.5rem; }

        .blog-content p {
            margin-bottom: 2.5rem;
            margin-top: 0;
            line-height: 2.1;
            text-align: justify;
            padding: 0;
        }

        .blog-content ul, .blog-content ol {
            margin: 3rem 0;
            padding-left: 2.5rem;
            line-height: 2.1;
        }

        .blog-content li {
            margin-bottom: 1.5rem;
            margin-left: 0.5rem;
        }

        .blog-content blockquote {
            margin: 3rem 0;
            padding: 2rem;
            border-left: 5px solid #6366f1;
            background-color: #f8f9fa;
            font-style: italic;
            color: #555;
            line-height: 2;
        }

        .blog-content img {
            max-width: 100%;
            height: auto;
            margin: 3rem 0;
            border-radius: 8px;
            display: block;
        }

        /* Code Block Styling */
        .code-block-wrapper {
            position: relative;
            background: #1e1e1e;
            border-radius: 12px;
            overflow: hidden;
            margin: 3rem 0;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            border: 1px solid #2d2d2d;
            display: flex;
            flex-direction: column;
        }

        .blog-content pre {
            background-color: #1e1e1e !important;
            padding: 1.5rem;
            margin: 0;
            border-radius: 0;
            box-shadow: none;
            border: none;
            max-height: 600px !important;
            overflow-y: scroll !important;
            overflow-x: auto !important;
            display: block;
            flex-grow: 1;
            scroll-behavior: smooth;
        }

        .blog-content pre::-webkit-scrollbar {
            width: 12px;
            height: 8px;
        }

        .blog-content pre::-webkit-scrollbar-track {
            background: #2d2d2d;
            border-radius: 10px;
        }

        .blog-content pre::-webkit-scrollbar-thumb {
            background: #6366f1;
            border-radius: 10px;
        }

        .blog-content pre::-webkit-scrollbar-thumb:hover {
            background: #764ba2;
        }

        /* Author Section */
        .author-section {
            background: #f8f9fa;
            padding: 30px;
            border-radius: 12px;
            margin: 60px 0 40px 0;
            display: flex;
            align-items: center;
            gap: 20px;
            border: 1px solid #e2e8f0;
        }

        .author-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #6366f1;
        }

        .author-info h4 {
            margin: 0 0 5px 0;
            font-size: 1.2rem;
            color: #1e293b;
        }

        .author-info p {
            margin: 5px 0;
            color: #64748b;
            font-size: 0.95rem;
        }

        .author-actions {
            margin-left: auto;
        }

        .author-actions button {
            margin-left: 10px;
        }

        /* Blog Actions Section */
        .blog-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 0;
            border-top: 1px solid #e2e8f0;
            border-bottom: 1px solid #e2e8f0;
            margin: 40px 0;
            flex-wrap: wrap;
            gap: 15px;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .action-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border: 1px solid #e2e8f0;
            background: white;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
            color: #64748b;
        }

        .action-btn:hover {
            background: #f8f9fa;
            border-color: #6366f1;
            color: #6366f1;
        }

        .action-btn.active {
            background: #6366f1;
            color: white;
            border-color: #6366f1;
        }

        .action-btn i {
            font-size: 1.1rem;
        }

        .tags-section {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .tag {
            background: #f1f5f9;
            color: #6366f1;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .tag:hover {
            background: #6366f1;
            color: white;
        }

        /* Comments Section */
        .comments-section {
            margin-top: 60px;
            padding-top: 40px;
            border-top: 2px solid #f0f0f0;
        }

        .comments-section h3 {
            font-size: 1.8rem;
            margin-bottom: 30px;
            color: #1e293b;
        }

        .comment-form {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 30px;
            border: 1px solid #e2e8f0;
        }

        .comment-form textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-family: inherit;
            resize: vertical;
            min-height: 100px;
        }

        .comment-form button {
            margin-top: 15px;
        }

        .comment {
            padding: 20px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            margin-bottom: 20px;
            background: white;
        }

        .comment-author {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
        }

        .comment-author-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .comment-author-info {
            flex: 1;
        }

        .comment-author-info strong {
            display: block;
            color: #1e293b;
        }

        .comment-author-info small {
            color: #94a3b8;
        }

        .comment-content {
            color: #475569;
            line-height: 1.6;
            margin: 12px 0;
        }

        /* Related Blogs */
        .related-section {
            margin-top: 80px;
            padding-top: 40px;
            border-top: 2px solid #f0f0f0;
        }

        .related-section h3 {
            font-size: 1.8rem;
            margin-bottom: 30px;
            color: #1e293b;
        }

        .related-blogs {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .related-blog-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .related-blog-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .related-blog-image {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }

        .related-blog-content {
            padding: 15px;
        }

        .related-blog-content h4 {
            margin: 0 0 10px 0;
            font-size: 1rem;
            color: #1e293b;
            line-height: 1.4;
        }

        .related-blog-content p {
            margin: 0;
            color: #64748b;
            font-size: 0.85rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        @media (max-width: 768px) {
            .blog-header h1 { font-size: 2rem; }
            .blog-meta { flex-direction: column; align-items: flex-start; }
            .author-section { flex-direction: column; }
            .author-actions { margin-left: 0; width: 100%; }
            .blog-actions { flex-direction: column; align-items: flex-start; }
            .action-buttons { width: 100%; }
        }
    </style>
</head>
<body>
    <%- include("./partials/nave") %>

    <!-- Blog Header -->
    <div class="blog-header">
        <div class="blog-container">
            <h1><%= blog.title %></h1>
            <div class="blog-meta">
                <div class="blog-meta-item">
                    <img src="<%= blog.createdBy?.profileImageURL || '/imgs/default.png' %>" 
                         alt="<%= blog.createdBy?.fullName %>" 
                         width="36" height="36" 
                         class="rounded-circle"
                         onerror="this.src='/imgs/default.png';">
                    <span><%= blog.createdBy?.fullName %></span>
                </div>
                <div class="blog-meta-item">
                    📅 <%= formatDate(blog.createdAt) %>
                </div>
                <div class="reading-time">
                    ⏱️ <%= blog.readingTime || 5 %> min read
                </div>
                <div class="blog-meta-item">
                    👁️ <%= blog.viewCount || 0 %> views
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="blog-container">
        <!-- Cover Image -->
        <% if (blog.coverImageURL) { %>
            <img src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" 
                 style="width: 100%; max-height: 400px; object-fit: cover; border-radius: 12px; margin-bottom: 40px;">
        <% } %>

        <!-- Blog Content -->
        <article class="blog-content">
            <%- renderMarkdown(blog.body) %>
        </article>

        <!-- Blog Actions -->
        <div class="blog-actions">
            <div class="action-buttons">
                <button class="action-btn" id="likeBtn" onclick="toggleLike()">
                    <i class="far fa-heart"></i>
                    <span id="likeCount"><%= blog.likes?.length || 0 %></span>
                </button>
                <button class="action-btn" onclick="document.getElementById('commentForm').scrollIntoView({ behavior: 'smooth' })">
                    <i class="far fa-comment"></i>
                    <span><%= blog.comments?.length || 0 %></span>
                </button>
                <button class="action-btn" onclick="sharePost()">
                    <i class="fas fa-share"></i>
                    Share
                </button>
            </div>

            <% if (blog.tags && blog.tags.length > 0) { %>
                <div class="tags-section">
                    <% blog.tags.forEach(tag => { %>
                        <a href="/?search=<%= tag %>" class="tag"><%= tag %></a>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Author Section -->
        <div class="author-section">
            <img src="<%= blog.createdBy?.profileImageURL || '/imgs/default.png' %>" 
                 alt="<%= blog.createdBy?.fullName %>" 
                 class="author-avatar"
                 onerror="this.src='/imgs/default.png';">
            
            <div class="author-info">
                <h4><%= blog.createdBy?.fullName %></h4>
                <p><%= blog.createdBy?.bio || 'A passionate blogger' %></p>
            </div>

            <% if (locals.user && locals.user._id != blog.createdBy._id) { %>
                <div class="author-actions">
                    <button class="btn btn-outline-primary btn-sm" onclick="toggleFollow('<%= blog.createdBy._id %>', this)">
                        <i class="fas fa-user-plus"></i> Follow
                    </button>
                </div>
            <% } %>
        </div>

        <!-- Comments Section -->
        <div class="comments-section">
            <h3><i class="fas fa-comments"></i> Comments</h3>

            <% if (locals.user) { %>
                <div class="comment-form" id="commentForm">
                    <form id="commentFormElement" onsubmit="submitComment(event)">
                        <textarea id="commentContent" placeholder="Share your thoughts..." required></textarea>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane"></i> Post Comment
                        </button>
                    </form>
                </div>
            <% } else { %>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> 
                    <a href="/user/signin">Sign in</a> to leave a comment
                </div>
            <% } %>

            <div id="commentsContainer">
                <!-- Comments will be loaded here -->
                <p class="text-muted text-center">Loading comments...</p>
            </div>
        </div>

        <!-- Related Blogs -->
        <div class="related-section" id="relatedSection" style="display: none;">
            <h3><i class="fas fa-lightbulb"></i> You Might Also Like</h3>
            <div class="related-blogs" id="relatedBlogs"></div>
        </div>
    </div>

    <%- include("./partials/scripts") %>

    <script>
        const blogId = '<%= blog._id %>';
        const userId = '<%= locals.user ? locals.user._id : "" %>';

        // Load comments on page load
        document.addEventListener('DOMContentLoaded', () => {
            loadComments();
            trackView();
            loadRelatedBlogs();
        });

        // Track blog view
        async function trackView() {
            try {
                await axios.post(`/blogs/${blogId}/view`);
            } catch (err) {
                console.error('Error tracking view:', err);
            }
        }

        // Load comments
        async function loadComments(page = 1) {
            try {
                const response = await axios.get(`/comments/blog/${blogId}?page=${page}`);
                const data = response.data;

                if (data.comments && data.comments.length > 0) {
                    const html = data.comments.map(comment => `
                        <div class="comment">
                            <div class="comment-author">
                                <img src="${comment.author?.profileImageURL || '/imgs/default.png'}" 
                                     class="comment-author-avatar"
                                     onerror="this.src='/imgs/default.png';">
                                <div class="comment-author-info">
                                    <strong>${comment.author?.fullName}</strong>
                                    <small>${timeAgo(comment.createdAt)}</small>
                                </div>
                            </div>
                            <div class="comment-content">${comment.content}</div>
                        </div>
                    `).join('');
                    document.getElementById('commentsContainer').innerHTML = html;
                } else {
                    document.getElementById('commentsContainer').innerHTML = 
                        '<p class="text-muted text-center">No comments yet. Be the first to comment!</p>';
                }
            } catch (err) {
                console.error('Error loading comments:', err);
                notify.error('Failed to load comments');
            }
        }

        // Submit comment
        async function submitComment(event) {
            event.preventDefault();
            const content = document.getElementById('commentContent').value;

            if (!content.trim()) {
                notify.error('Comment cannot be empty');
                return;
            }

            try {
                const response = await axios.post(`/comments/blog/${blogId}`, { content });
                if (response.data.success) {
                    document.getElementById('commentContent').value = '';
                    loadComments();
                    notify.success('Comment posted successfully!');
                }
            } catch (err) {
                notify.error(err.response?.data?.message || 'Failed to post comment');
            }
        }

        // Toggle like
        async function toggleLike() {
            if (!userId) {
                notify.warning('Please sign in to like this blog');
                return;
            }

            try {
                const response = await axios.post(`/blogs/${blogId}/like`);
                if (response.data.success) {
                    document.getElementById('likeCount').textContent = response.data.likeCount;
                    const btn = document.getElementById('likeBtn');
                    if (response.data.liked) {
                        btn.classList.add('active');
                        btn.innerHTML = '<i class="fas fa-heart"></i> <span id="likeCount">' + response.data.likeCount + '</span>';
                    } else {
                        btn.classList.remove('active');
                        btn.innerHTML = '<i class="far fa-heart"></i> <span id="likeCount">' + response.data.likeCount + '</span>';
                    }
                }
            } catch (err) {
                notify.error(err.response?.data?.message || 'Failed to like blog');
            }
        }

        // Share post
        function sharePost() {
            const shareUrl = window.location.href;
            const shareText = '<%= blog.title %>';

            if (navigator.share) {
                navigator.share({
                    title: shareText,
                    url: shareUrl
                });
            } else {
                const text = `Check out this blog: "${shareText}" ${shareUrl}`;
                navigator.clipboard.writeText(text);
                notify.success('Link copied to clipboard!');
            }
        }

        // Load related blogs
        async function loadRelatedBlogs() {
            try {
                const tags = '<%= JSON.stringify(blog.tags || []) %>';
                if (tags && tags.length > 2) {
                    // Load related blogs by tags
                    const response = await axios.get(`/?search=${tags[0]}&limit=3`);
                    // Implementation depends on your backend
                }
            } catch (err) {
                console.error('Error loading related blogs:', err);
            }
        }

        // Follow author
        async function toggleFollow(authorId, btn) {
            try {
                const response = await axios.post(`/follow/${authorId}/follow`);
                if (response.data.success) {
                    if (response.data.following) {
                        btn.innerHTML = '<i class="fas fa-user-check"></i> Following';
                        btn.classList.remove('btn-outline-primary');
                        btn.classList.add('btn-success');
                    } else {
                        btn.innerHTML = '<i class="fas fa-user-plus"></i> Follow';
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-outline-primary');
                    }
                    notify.success(response.data.message);
                }
            } catch (err) {
                notify.error(err.response?.data?.message || 'Action failed');
            }
        }
    </script>
</body>
</html>

